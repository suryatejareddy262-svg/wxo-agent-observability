# =============================================================================
# config/azure.env.example  —  Azure AI Foundry Configuration
# =============================================================================
# Copy this file to config/azure.env and fill in your values:
#   cp config/azure.env.example config/azure.env
#
# Commands:
#   ./wire_agent.sh --azure --hosted     # Flow B: kind:hosted (default)
#   ./wire_agent.sh --azure --prompt     # Flow A: kind:prompt (Function App)
#   ./wire_agent.sh --azure --dry-run    # validate configuration without changes
# =============================================================================

# ── Azure Subscription & Resource Group ───────────────────────────────────────
export AZURE_SUBSCRIPTION_ID="<your-azure-subscription-id>"
export AZURE_RESOURCE_GROUP="<your-azure-resource-group>"
export AZURE_LOCATION="eastus"

# ── AI Foundry Account & Project (Required for --hosted / Flow B) ─────────────
export AZURE_ACCOUNT="<your-ai-foundry-account>"
export AZURE_PROJECT="<your-ai-foundry-project>"

# ── Log Analytics Workspace (Required for --prompt / Flow A) ─────────────────
export LOG_ANALYTICS_WORKSPACE_ID="<your-log-analytics-workspace-id>"
export LOG_ANALYTICS_WORKSPACE_NAME="<your-log-analytics-workspace-name>"

# ── Azure Function App (Required for --prompt / Flow A) ──────────────────────
export FUNCTION_APP_NAME="wxo-foundry-prompt-tracer"
export STORAGE_ACCOUNT_NAME="<unique-storage-account-name>"

# ── WXO Platform Credentials ──────────────────────────────────────────────────
export WXO_DEPLOYMENT_MODE="cloud"      # cloud | cpd
export API_KEY="<your-wxo-api-key>"
export TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
export WXO_TENANT_ID="<your-wxo-tenant-id>"
export WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"
export ENVIRONMENT_NAME="draft"         # draft | live

# ── Agent Mapping (required) ──────────────────────────────────────────────────
# One or many agents. Each key is the exact Foundry agent name.
export WXO_AGENT_MAP='{
  "default": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Azure Foundry Agent"
  }
}'
