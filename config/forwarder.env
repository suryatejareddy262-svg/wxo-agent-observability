# =============================================================================
# config/forwarder.env.example  —  OTLP Trace Forwarder Configuration
# =============================================================================
# Copy this file to config/forwarder.env and fill in your values:
#   cp config/forwarder.env.example config/forwarder.env
#
# Commands:
#   ./wire_agent.sh --forwarder                         # run local OTLP receiver daemon
#   ./wire_agent.sh --forwarder --deploy                # deploy forwarder per FORWARDER_TARGET
#   ./wire_agent.sh --forwarder --deploy --claude       # deploy & configure Claude OTel telemetry
#   ./wire_agent.sh --forwarder --sync                  # sync agent map without code redeploy
#   ./wire_agent.sh --forwarder --dry-run               # validate configuration without changes
# =============================================================================

# ── WXO Platform Credentials ──────────────────────────────────────────────────
export WXO_DEPLOYMENT_MODE="cloud"      # cloud | cpd
export ENVIRONMENT_NAME="draft"         # draft | live

# cloud mode (IBM Cloud SaaS):
export API_KEY="<your-wxo-api-key>"
export TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
export WXO_TENANT_ID="<your-wxo-tenant-id>"
export WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"

# cpd mode (on-prem Cloud Pak for Data) — uncomment and set:
# export CPD_HOST_URL="https://cpd-<namespace>.apps.<cluster-domain>"
# export CPD_USERNAME="<cpd-username>"
# export CPD_PASSWORD="<cpd-password>"
# export CPD_INSTANCE_ID="<wxo-instance-id>"
# export CPD_NAMESPACE="<cpd-namespace>"
# export CPD_VERIFY_TLS="false"

# ── Agent Mapping (required) ──────────────────────────────────────────────────
# Maps agent keys, service names, model names, or IDs to WXO agent UUIDs.
# Resolution order: URL path (/v1/traces/<key>) → ?agent_id= param →
# x-agent-id header → span attribute agent.id / gen_ai.agent.id → exact key match → "default"
export WXO_AGENT_MAP='{
  "default": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Default Fallback Agent"
  },
  "my-claude-agent": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Claude Agent"
  },
  "customer-support-bot": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Customer Support Agent",
    "wxo_tenant_id":    "<optional-different-tenant-id>",
    "environment":      "live"
  }
}'

# ── Forwarder Settings ────────────────────────────────────────────────────────
export FORWARDER_TARGET="aws"           # aws | azure | docker
export OTLP_PORT="4318"                 # Local / Docker listening port
export FORWARDER_AUTH_TOKEN=""          # Optional: require 'Authorization: Bearer <token>'

# ── Claude / Anthropic OTel Telemetry Destination ────────────────────────────
# Used by: ./wire_agent.sh --forwarder --deploy --claude
# export ANTHROPIC_ADMIN_API_KEY="sk-ant-admin..."  # or export in shell
# export ANTHROPIC_WORKSPACE_ID="wrkspc_..."        # comma-separated IDs, or "all"
# export ANTHROPIC_DESTINATION_NAME="watsonx Orchestrate - Agent Analytics (OTLP forwarder)"
# export ANTHROPIC_CONTENT_MODE="content"           # "content" (full payload) or "metadata_only"

# ── Docker Target Settings (FORWARDER_TARGET="docker") ───────────────────────
export DOCKER_IMAGE_NAME="wxo-otlp-forwarder"
export DOCKER_CONTAINER_NAME="wxo-otlp-forwarder"

# ── AWS Lambda Target Settings (FORWARDER_TARGET="aws") ──────────────────────
export AWS_REGION="us-east-1"
export AWS_DEFAULT_REGION="us-east-1"
export AWS_LAMBDA_FUNCTION_NAME="wxo-otlp-forwarder"
export SSM_SETTINGS_PATH="/wxo-agent/settings"
export SSM_AGENT_MAP_PATH="/wxo-agent/agent_map"
# If using AWS CLI credentials, leave these blank:
export AWS_ACCOUNT_ID="<your-aws-account-id>"
export AWS_ACCESS_KEY_ID="<your-aws-access-key-id>"
export AWS_SECRET_ACCESS_KEY="<your-aws-secret-access-key>"

# ── Azure Function App Target Settings (FORWARDER_TARGET="azure") ─────────────
export AZURE_SUBSCRIPTION_ID="<your-azure-subscription-id>"
export AZURE_RESOURCE_GROUP="<your-azure-resource-group>"
export AZURE_LOCATION="westus2"
export AZURE_FUNCTION_APP_NAME="wxo-forwader-tracer"
export AZURE_STORAGE_ACCOUNT="<your-storage-account-name>"
