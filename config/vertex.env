# =============================================================================
# config/vertex.env.example  —  Vertex AI Configuration
# =============================================================================
# Copy this file to config/vertex.env and fill in your values:
#   cp config/vertex.env.example config/vertex.env
#
# Commands:
#   ./wire_agent.sh --vertex --selfhosted        # Self-hosted container
#   ./wire_agent.sh --vertex --reasoning-engine  # Reasoning Engine
#   ./wire_agent.sh --vertex --dry-run           # validate configuration without changes
# =============================================================================

# ── GCP Project & Region ──────────────────────────────────────────────────────
export GCP_PROJECT_ID="<your-gcp-project-id>"
export GCP_REGION="us-central1"
export GOOGLE_APPLICATION_CREDENTIALS="<path-to-service-account-key.json>"

# ── Self-hosted Shared Container Config ───────────────────────────────────────
export GCP_ARTIFACT_REGISTRY="<destination-artifact-registry-url>"
export CONTAINER_TARGET="cloudrun"      # cloudrun | artifact

# ── WXO Platform Credentials ──────────────────────────────────────────────────
export WXO_DEPLOYMENT_MODE="cloud"      # cloud | cpd
export API_KEY="<your-wxo-api-key>"
export TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
export WXO_TENANT_ID="<your-wxo-tenant-id>"
export WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"
export ENVIRONMENT_NAME="draft"         # draft | live

# ── Agent Mapping (required) ──────────────────────────────────────────────────
# One or many agents.
# Required fields:
#   --selfhosted:       source_image
#   --reasoning-engine: reasoning_engine_id
export WXO_AGENT_MAP='{
  "default": {
    "wxo_agent_id":        "<your-wxo-agent-uuid>",
    "wxo_display_name":    "Vertex AI Agent",
    "reasoning_engine_id": "<reasoning-engine-id>"
  }
}'
